# Server Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_change_in_production
CRON_SECRET=github_actions_cron_secret_token_12345

# Storage Mode: "turso" | "sheets" | "dual" (default: "dual")
STORAGE_MODE=dual

# Turso (libSQL) Edge Database
# For local zero-config testing: file:local.db
# For production Turso cloud: libsql://your-db-org.turso.io
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Google Sheets Configuration (for Live Mirror / Backbone)
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Note: In .env, replace actual newlines in private key with \n
GOOGLE_PRIVATE_KEY=

# Multimodal Vision / OCR API Key (Gemini Flash Vision)
GEMINI_API_KEY=
